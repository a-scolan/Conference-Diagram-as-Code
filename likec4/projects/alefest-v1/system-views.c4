/**
 * AleFest Café V1 - Vues d'architecture
 * Organisation : C1 Contexte | C2 Conteneurs | Cas d'usage
 */

// ============================================================================
// VUE INDEX (point d'entrée)
// ============================================================================

views {
  view index extends c1_context {
    title 'AleFest Café V1 - Vue d\'ensemble'
  }
}

// ============================================================================
// C1 - CONTEXTE (système comme boîte noire)
// ============================================================================

views 'C1' {
  view c1_context {
    title 'Vue de contexte - Système AleFest Café'
    description '''
      Le festivalier commande depuis son mobile ou au comptoir.
      Le barista gère la file en temps réel.
      V1 découple les services via RabbitMQ et notifications push.
    '''
    
    include *
    
    autoLayout TopBottom
  }
}

// ============================================================================
// C2 - ARCHITECTURE APPLICATIVE (conteneurs)
// ============================================================================

views 'C2' {
  view c2_containers of alefestCoffee {
    title 'Architecture du système de commande (V1)'
    description '''
      Trois interfaces : Application Festival, Application Comptoir,
      Écran Barista.
      Deux services backend : Commande, Préparation.
      RabbitMQ et PostgreSQL assurent la coordination et la persistance.
    '''
    
    include
      festivalier,
      barista,
      alefestCoffee.*
    
    include -> alefestCoffee
    include alefestCoffee ->
    
    autoLayout TopBottom
    
    style alefestCoffee.eventBus {
      color amber
    }
    
  }
}

// ============================================================================
// CAS D'USAGE - VUES DYNAMIQUES (flux temporels)
// ============================================================================

views 'Cas d usage' {

  dynamic view order_counter_flow {
    title 'Scénario : commande au comptoir'
    description '''
      Parcours de secours au comptoir avec la même chaîne d'événements.
    '''
    
    festivalier -> alefestCoffee.counterApp 'Commande au comptoir'
    alefestCoffee.counterApp -> alefestCoffee.orderService 'POST /orders'
    alefestCoffee.orderService -> alefestCoffee.database 'INSERT order'
    alefestCoffee.orderService -> alefestCoffee.eventBus 'Publie order.placed'
    alefestCoffee.eventBus -> alefestCoffee.preparationService 'Consomme order.placed'
    alefestCoffee.preparationService -> alefestCoffee.baristaScreen 'WebSocket push nouvelle commande'
    alefestCoffee.baristaScreen -> barista 'Affiche dans la file'
	barista -> festivalier 'fournir la boisson' {
	  technology 'Interaction physique'
	}
  }
}
