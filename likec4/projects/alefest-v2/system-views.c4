/**
 * AleFest Café V2 - Vues d'architecture
 * Organisation : C1 Contexte | C2 Conteneurs | Cas d'usage
 */

// ============================================================================
// VUE INDEX (point d'entrée)
// ============================================================================

views {
  view index extends c1_context {
    title 'AleFest Café V2 - Vue d\'ensemble'
  }
}

// ============================================================================
// C1 - CONTEXTE (système comme boîte noire)
// ============================================================================

views 'C1' {
  view c1_context {
    title 'Vue de contexte - Système AleFest Café'
    description '''
      Le festivalier commande via le Système Festival (externe)
      ou au comptoir.
      Le barista gère la file en temps réel.
      V2 découple les services via RabbitMQ et notifications push.
    '''
    
    include
      festivalier,
      barista,
      festivalSystem,
      alefestCoffee
    
    autoLayout TopBottom
  }
}

// ============================================================================
// C2 - ARCHITECTURE APPLICATIVE (conteneurs)
// ============================================================================

views 'C2' {
  view c2_containers of alefestCoffee {
    title 'Architecture du système de commande (V2)'
    description '''
      Interfaces : App Festival (externe), Application Comptoir,
      Écran Barista.
      Trois services backend : Commande, Préparation, Notification.
      RabbitMQ et PostgreSQL assurent la coordination et la persistance.
    '''
    
    include
      festivalier,
      barista,
      festivalSystem,
      festivalSystem.*,
      alefestCoffee.*
    
    include -> alefestCoffee
    include alefestCoffee ->
    
    autoLayout TopBottom
    
    style alefestCoffee.eventBus {
      color amber
    }
  }
}

// ============================================================================
// CAS D'USAGE - VUES DYNAMIQUES (flux temporels)
// ============================================================================

views 'Cas d usage' {
  dynamic view order_mobile_flow {
    title 'Scénario : commande mobile'
    description '''
      Le festivalier commande à distance, reçoit une notification,
      puis vient récupérer son café quand il est prêt.
    '''
    
    // Étape 1 : Commande mobile
    festivalier -> festivalSystem.festivalApp 'Ouvre l\'application festival et commande un cappuccino'
    festivalSystem.festivalApp -> festivalSystem.festivalService 'POST /orders - Demande café AleFest'
    festivalSystem.festivalService -> alefestCoffee.orderService 'POST /orders - Créer la commande mobile'
    alefestCoffee.orderService -> alefestCoffee.database 'INSERT order #42 (pending)'
    
    // Étape 2 : Publication event
    alefestCoffee.orderService -> alefestCoffee.eventBus 'Publie order.placed (#42, cappuccino, lait avoine)'
    alefestCoffee.orderService -> festivalSystem.festivalService 'Retourne order #42'
    festivalSystem.festivalService -> festivalSystem.festivalApp 'Retourne order #42'
    festivalSystem.festivalApp -> festivalier 'Confirmation "Commande #42 enregistrée"'
    
    // Étape 3 : Festivalier repart
    festivalier -> festivalier '🎉 Repart écouter le concert (LIBÉRÉ !)'
    
    // Étape 4 : Preparation Service consomme event
    alefestCoffee.eventBus -> alefestCoffee.preparationService 'Consomme order.placed'
    alefestCoffee.preparationService -> alefestCoffee.database 'UPDATE order #42 → ajout file FIFO'
    
    // Étape 5 : Barista voit commande (WebSocket)
    alefestCoffee.preparationService -> alefestCoffee.baristaScreen 'WebSocket push : nouvelle commande #42'
    alefestCoffee.baristaScreen -> barista 'Affiche ordre #42 dans la file'
    
    // Étape 6 : Préparation
    barista -> alefestCoffee.baristaScreen 'Clique "En préparation"'
    alefestCoffee.baristaScreen -> alefestCoffee.preparationService 'PATCH /orders/42/status → preparing'
    alefestCoffee.preparationService -> alefestCoffee.database 'UPDATE order #42'
    alefestCoffee.preparationService -> alefestCoffee.eventBus 'Publie order.preparing (#42)'
    
    // Étape 7 : Café prêt
    barista -> alefestCoffee.baristaScreen 'Clique "Prêt"'
    alefestCoffee.baristaScreen -> alefestCoffee.preparationService 'PATCH /orders/42/status → ready'
    alefestCoffee.preparationService -> alefestCoffee.database 'UPDATE order #42'
    alefestCoffee.preparationService -> alefestCoffee.eventBus 'Publie order.ready (#42)'
    
    // Étape 8 : Push notification
    alefestCoffee.eventBus -> alefestCoffee.notificationService 'Consomme order.ready'
    alefestCoffee.notificationService -> festivalSystem.festivalApp 'Push Firebase : « Votre cappuccino est prêt ! »'
    festivalSystem.festivalApp -> festivalier '📱 Notification reçue'
    
    // Étape 9 : Récupération
    festivalier -> barista 'Vient récupérer son cappuccino au comptoir'
  }

  dynamic view order_counter_flow {
    title 'Scénario : commande au comptoir (secours)'
    description '''
      Parcours de secours au comptoir avec la même chaîne d'événements.
    '''
    
    festivalier -> alefestCoffee.counterApp 'Commande au comptoir'
    alefestCoffee.counterApp -> alefestCoffee.orderService 'POST /orders'
    alefestCoffee.orderService -> alefestCoffee.database 'INSERT order'
    alefestCoffee.orderService -> alefestCoffee.eventBus 'Publie order.placed'
    alefestCoffee.eventBus -> alefestCoffee.preparationService 'Consomme order.placed'
    alefestCoffee.preparationService -> alefestCoffee.baristaScreen 'WebSocket push nouvelle commande'
    alefestCoffee.baristaScreen -> barista 'Affiche dans la file'
  }
}
