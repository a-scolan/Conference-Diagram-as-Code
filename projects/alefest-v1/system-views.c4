/**
 * AleFest Coffee V1 - Vues d'architecture
 * Organisation : C1 Context | C2 Containers | Use Cases (flows dynamiques)
 */

// ============================================================================
// VUE INDEX (point d'entrée)
// ============================================================================

views {
  view index extends c1_context {
    title 'AleFest Coffee V1 - Vue d\'ensemble'
  }
}

// ============================================================================
// C1 - CONTEXTE (Système comme boîte noire)
// ============================================================================

views 'C1' {
  view c1_context {
    title 'Vue de Contexte - Système AleFest Coffee'
    description '''
      Vue de contexte métier : acteurs et système.
      
      **Acteurs externes et leurs interactions :**
      - Festivalier : utilise Counter App (borne tactile au comptoir)
      - Barista : utilise Barista Screen (écran de gestion des commandes)
      
      **Système :**
      AleFest Coffee - Système de gestion de commandes de café.
      
      **V1 (synchrone) :**
      Le festivalier commande au comptoir via Counter App et attend sur place
      pendant que le barista prépare la commande sur Barista Screen.
    '''
    
    include *
    
    autoLayout TopBottom
  }
}

// ============================================================================
// C2 - ARCHITECTURE APPLICATIVE (Containers)
// ============================================================================

views 'C2' {
  view c2_containers of alefestCoffee {
    title 'Architecture du Système de Commande'
    description '''
      Architecture interne complète du système AleFest Coffee V1.
      
      **4 Containers :**
      - Counter App : SPA de prise de commande (comptoir tactile)
      - Barista Screen : SPA d'affichage de la file barista
      - Coffee Service : Backend monolithe REST
      - PostgreSQL : Base de données
      
      **Pattern technique - Polling HTTP :**
      - Counter App : GET /orders/:id toutes les 3 secondes
      - Barista Screen : GET /orders/queue toutes les 2 secondes
      
      **Limitations :**
      - Gaspillage bande passante
      - Latence 2-3 secondes
      - Festivalier bloqué au comptoir
      
      **Solution V2 :** WebSocket temps réel + commande mobile.
    '''
    
    include
      festivalier,
      barista,
      alefestCoffee.*
    
    include -> alefestCoffee
    include alefestCoffee ->
    
    autoLayout TopBottom
    
    style alefestCoffee.coffeeService {
      color red
    }
  }
}

// ============================================================================
// USE CASES - VUES DYNAMIQUES (flows temporels)
// ============================================================================

views 'Use Cases' {
  dynamic view order_flow {
    title 'Scénario : Commander un café'
    description '''
      Flow complet d'une commande synchrone en V1.
      
      **Étapes :**
      1. Festivalier commande au comptoir (Counter App)
      2. Création commande dans Coffee Service
      3. Stockage en base PostgreSQL
      4. Barista consulte la file (polling)
      5. Barista prépare et marque "Prêt"
      6. Festivalier voit "Prêt" (polling)
      7. Festivalier récupère son café
      
      **⚠️ Limitation V1 :** Festivalier bloqué au comptoir pendant 3-5 min.
    '''
    
    // Étape 1 : Commande
    festivalier -> alefestCoffee.counterApp 'Sélectionne son café (cappuccino, lait d\'avoine)'
    alefestCoffee.counterApp -> alefestCoffee.coffeeService 'POST /orders - Créer commande'
    alefestCoffee.coffeeService -> alefestCoffee.database 'INSERT order (status: pending)'
    alefestCoffee.coffeeService -> alefestCoffee.counterApp 'Retourne order #42'
    alefestCoffee.counterApp -> festivalier 'Affiche "Commande #42 enregistrée"'
    
    // Étape 2 : Barista consulte (polling)
    barista -> alefestCoffee.baristaScreen 'Consulte la file d\'attente'
    alefestCoffee.baristaScreen -> alefestCoffee.coffeeService 'GET /orders/queue (polling 2s)'
    alefestCoffee.coffeeService -> alefestCoffee.database 'SELECT orders WHERE status = pending'
    
    // Étape 3 : Préparation
    barista -> alefestCoffee.baristaScreen 'Clique "En préparation"'
    alefestCoffee.baristaScreen -> alefestCoffee.coffeeService 'PATCH /orders/42/status → preparing'
    alefestCoffee.coffeeService -> alefestCoffee.database 'UPDATE order #42'
    
    // Étape 4 : Prêt
    barista -> alefestCoffee.baristaScreen 'Clique "Prêt"'
    alefestCoffee.baristaScreen -> alefestCoffee.coffeeService 'PATCH /orders/42/status → ready'
    alefestCoffee.coffeeService -> alefestCoffee.database 'UPDATE order #42'
    
    // Étape 5 : Notification (polling)
    alefestCoffee.counterApp -> alefestCoffee.coffeeService 'GET /orders/42 (polling 3s)'
    alefestCoffee.coffeeService -> alefestCoffee.counterApp 'Retourne status: ready'
    alefestCoffee.counterApp -> festivalier 'Affiche "Commande #42 PRÊTE !"'
    
    // Étape 6 : Récupération
    festivalier -> barista 'Récupère son cappuccino au comptoir'
  }
}
