/**
 * AleFest Coffee V1 - Le Comptoir
 * Architecture synchrone : commande au comptoir et attente sur place
 */

model {
  // ============================================================================
  // NIVEAU CONTEXTE C1 - Acteurs et Système
  // ============================================================================

  festivalier = Actor_Person 'Festivalier' {
    description '''
      Client du stand café au festival AleFest.
      
      **Comportement V1:**
      - Commande au comptoir sur une borne tactile
      - Attend sur place devant le bar
      - Surveille l'écran pour savoir quand son café est prêt
      - Récupère son café au comptoir
    '''
  }

  barista = Actor_Staff 'Barista' {
    description '''
      Personnel du stand café préparant les commandes.
      
      **Responsabilités:**
      - Consulter la file d'attente sur écran dédié
      - Préparer les cafés dans l'ordre FIFO
      - Marquer les commandes comme "en préparation" / "prêt"
      - Appeler le client au comptoir
    '''
  }

  // Système
  alefestCoffee = System_New 'AleFest Coffee' {
    description '''
      Système de gestion de commandes pour le stand café du festival.
      
      **Objectif:**
      Digitaliser la prise de commande pour réduire la file d'attente physique
      et améliorer le suivi des préparations.
      
      **Version V1 - Architecture synchrone:**
      - Commande au comptoir uniquement
      - Backend monolithique
      - Polling HTTP pour les mises à jour
      - Pas de notification push
    '''

    // ============================================================================
    // NIVEAU CONTAINERS C2 - Composants applicatifs
    // ============================================================================

    counterApp = Container_Spa 'Counter App' {
      technology 'React, TypeScript, Vite'
      description '''
        Borne de commande tactile installée au comptoir.
        
        **Fonctionnalités:**
        - Affichage de la carte des cafés (espresso, latte, cappuccino, flat white, filter)
        - Prise de commande avec options (lait, sucre, taille)
        - Affichage du numéro de commande
        - Polling pour afficher "Commande #X prête !"
        
        **UX V1:**
        Le festivalier reste devant le comptoir et surveille l'écran.
      '''
    }

    baristaScreen = Container_Spa 'Barista Screen' {
      technology 'React, TypeScript, WebSocket fallback polling'
      description '''
        Écran dédié derrière le bar affichant la file de préparation.
        
        **Fonctionnalités:**
        - Liste des commandes en attente (ordre FIFO)
        - Détail de chaque commande (boisson + options)
        - Boutons "En préparation" / "Prêt"
        - Compteur de commandes traitées
        
        **Technique V1:**
        Fait du polling HTTP toutes les 2 secondes pour rafraîchir la liste.
      '''
    }

    coffeeService = Container_Api 'Coffee Service' {
      technology 'Node.js, Express, Sequelize ORM'
      description '''
        Backend monolithique gérant toute la logique métier.
        
        **Responsabilités:**
        - CRUD des commandes (POST /orders, GET /orders/:id, PATCH /orders/:id/status)
        - Gestion de la file d'attente (GET /orders/queue)
        - Gestion du catalogue (GET /menu)
        - Gestion des statuts (pending → preparing → ready → picked_up)
        - Validation des commandes
        
        **Architecture V1 - Monolithe:**
        Toute la logique dans un seul service. Simple mais couplé.
        Pas de séparation entre commande et préparation.
      '''
    }

    database = Container_Database 'PostgreSQL' {
      technology 'PostgreSQL 16'
      description '''
        Base de données relationnelle stockant les commandes et le menu.
        
        **Tables:**
        - orders: id, items[], status, customer_number, created_at, updated_at
        - menu_items: id, name, category, price, available
        
        **Statuts:**
        - pending: en attente de préparation
        - preparing: en cours de préparation
        - ready: prêt à être récupéré
        - picked_up: récupéré par le client
      '''
    }

    // ============================================================================
    // RELATIONS C2
    // ============================================================================

    // Counter App → Coffee Service
    counterApp -[calls]-> coffeeService 'POST /orders - Créer commande' {
      technology 'HTTPS, REST'
    }
    counterApp -[calls]-> coffeeService 'GET /orders/:id - Polling statut' {
      technology 'HTTPS, REST, polling 3s'
    }

    // Barista Screen → Coffee Service
    baristaScreen -[calls]-> coffeeService 'GET /orders/queue - Polling file' {
      technology 'HTTPS, REST, polling 2s'
    }
    baristaScreen -[calls]-> coffeeService 'PATCH /orders/:id/status - Maj statut' {
      technology 'HTTPS, REST'
    }

    // Coffee Service → Database
    coffeeService -[reads]-> database 'SELECT ordres et menu'
    coffeeService -[writes]-> database 'INSERT/UPDATE ordres'
  }

  // ============================================================================
  // RELATIONS C1 - Interactions acteurs/applications
  // ============================================================================

  festivalier -[uses]-> alefestCoffee.counterApp 'Commande un café au comptoir'
  barista -[uses]-> alefestCoffee.baristaScreen 'Consulte et gère les commandes'
}
