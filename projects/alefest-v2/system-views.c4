/**
 * AleFest Coffee V2 - Vues d'architecture
 * Organisation : C1 Context | C2 Containers | Use Cases (flows dynamiques)
 */

// ============================================================================
// VUE INDEX (point d'entrée)
// ============================================================================

views {
  view index extends c1_context {
    title 'AleFest Coffee V2 - Vue d\'ensemble'
  }
}

// ============================================================================
// C1 - CONTEXTE (Système comme boîte noire)
// ============================================================================

views 'C1' {
  view c1_context {
    title 'Vue de Contexte - Système AleFest Coffee'
    description '''
      Vue de contexte métier : acteurs et système.
      
      **Acteurs externes et leurs interactions :**
      - Festivalier : utilise Festival App (mobile) ou Counter App (comptoir)
      - Barista : utilise Barista Screen (écran de gestion des commandes)
      
      **Système :**
      AleFest Coffee - Système de gestion de commandes de café.
      
      **V2 (event-driven) :**
      Le festivalier commande à distance depuis Festival App,
      repart écouter le concert, et reçoit une notification push
      quand son café est prêt. Le barista gère les commandes sur Barista Screen.
    '''
    
    include *
    
    autoLayout TopBottom
  }
}

// ============================================================================
// C2 - ARCHITECTURE APPLICATIVE (Containers)
// ============================================================================

views 'C2' {
  view c2_containers of alefestCoffee {
    title 'Architecture du Système de Commande'
    description '''
      Architecture interne complète du système AleFest Coffee V2.
      
      **Frontend (3 containers) :**
      - Festival App : App mobile React Native (NOUVEAU) — commande à distance
      - Counter App : SPA comptoir (legacy) — compatibilité
      - Barista Screen : SPA affichage file — WebSocket temps réel
      
      **Backend microservices (3 services) :**
      - Order Service : Prise de commande
      - Preparation Service : Gestion file barista
      - Notification Service : Push notifications Firebase
      
      **Infrastructure (2 containers) :**
      - RabbitMQ : Message broker event-driven (NOUVEAU)
      - PostgreSQL : Base de données partagée
      
      **Améliorations V2 :**
      1. Microservices découplés via RabbitMQ (events)
      2. WebSocket pour push temps réel (vs polling HTTP)
      3. Festival App libère le festivalier pendant la préparation
      4. Push notifications automatiques
      5. Résilience et scalabilité indépendante
    '''
    
    include
      festivalier,
      barista,
      alefestCoffee.*
    
    include -> alefestCoffee
    include alefestCoffee ->
    
    autoLayout TopBottom
    
    style alefestCoffee.eventBus {
      color amber
    }
    
    style alefestCoffee.festivalApp {
      color green
    }
  }
}

// ============================================================================
// USE CASES - VUES DYNAMIQUES (flows temporels)
// ============================================================================

views 'Use Cases' {
  dynamic view order_mobile_flow {
    title 'Scénario : Commander depuis le mobile'
    description '''
      Flow complet d'une commande asynchrone en V2 avec app mobile.
      
      **Étapes :**
      1. Festivalier commande depuis son téléphone
      2. Order Service publie order.placed
      3. 🎉 Festivalier repart écouter le concert
      4. Preparation Service consomme l'event
      5. Barista voit la commande (WebSocket temps réel)
      6. Barista prépare et marque "Prêt"
      7. Notification Service envoie push notification
      8. Festivalier vient récupérer son café
      
      **✅ Amélioration V2 :** Festivalier libéré dès l'étape 3 (gain 3-5 min).
    '''
    
    // Étape 1 : Commande mobile
    festivalier -> alefestCoffee.festivalApp 'Ouvre l\'app et sélectionne cappuccino'
    alefestCoffee.festivalApp -> alefestCoffee.orderService 'POST /orders - Créer commande mobile'
    alefestCoffee.orderService -> alefestCoffee.database 'INSERT order #42 (status: pending)'
    
    // Étape 2 : Publication event
    alefestCoffee.orderService -> alefestCoffee.eventBus 'PUBLISH order.placed (#42, cappuccino, lait avoine)'
    alefestCoffee.orderService -> alefestCoffee.festivalApp 'Retourne order #42'
    alefestCoffee.festivalApp -> festivalier 'Confirmation "Commande #42 enregistrée"'
    
    // Étape 3 : Festivalier repart
    festivalier -> festivalier '🎉 Repart écouter le concert (LIBÉRÉ !)'
    
    // Étape 4 : Preparation Service consomme event
    alefestCoffee.eventBus -> alefestCoffee.preparationService 'CONSUME order.placed'
    alefestCoffee.preparationService -> alefestCoffee.database 'UPDATE order #42 → ajout file FIFO'
    
    // Étape 5 : Barista voit commande (WebSocket)
    alefestCoffee.preparationService -> alefestCoffee.baristaScreen 'WebSocket push : nouvelle commande #42'
    alefestCoffee.baristaScreen -> barista 'Affiche ordre #42 dans la file'
    
    // Étape 6 : Préparation
    barista -> alefestCoffee.baristaScreen 'Clique "En préparation"'
    alefestCoffee.baristaScreen -> alefestCoffee.preparationService 'PATCH /orders/42/status → preparing'
    alefestCoffee.preparationService -> alefestCoffee.database 'UPDATE order #42'
    alefestCoffee.preparationService -> alefestCoffee.eventBus 'PUBLISH order.preparing (#42)'
    
    // Étape 7 : Café prêt
    barista -> alefestCoffee.baristaScreen 'Clique "Prêt"'
    alefestCoffee.baristaScreen -> alefestCoffee.preparationService 'PATCH /orders/42/status → ready'
    alefestCoffee.preparationService -> alefestCoffee.database 'UPDATE order #42'
    alefestCoffee.preparationService -> alefestCoffee.eventBus 'PUBLISH order.ready (#42)'
    
    // Étape 8 : Push notification
    alefestCoffee.eventBus -> alefestCoffee.notificationService 'CONSUME order.ready'
    alefestCoffee.notificationService -> alefestCoffee.festivalApp 'Firebase push : "Votre cappuccino est prêt !"'
    alefestCoffee.festivalApp -> festivalier '📱 Notification push vibrante'
    
    // Étape 9 : Récupération
    festivalier -> barista 'Vient récupérer son cappuccino au comptoir'
  }

  dynamic view order_counter_flow {
    title 'Scénario : Commander au comptoir (legacy)'
    description '''
      Flow de commande au comptoir en V2 (compatibilité V1).
      
      Counter App maintenu pour :
      - Festivaliers sans smartphone
      - Problèmes réseau/batterie
      - Alternative de secours
      
      Appelle directement Order Service, même bus d'events.
    '''
    
    festivalier -> alefestCoffee.counterApp 'Commande au comptoir'
    alefestCoffee.counterApp -> alefestCoffee.orderService 'POST /orders'
    alefestCoffee.orderService -> alefestCoffee.database 'INSERT order'
    alefestCoffee.orderService -> alefestCoffee.eventBus 'PUBLISH order.placed'
    alefestCoffee.eventBus -> alefestCoffee.preparationService 'CONSUME order.placed'
    alefestCoffee.preparationService -> alefestCoffee.baristaScreen 'WebSocket push nouvelle commande'
    alefestCoffee.baristaScreen -> barista 'Affiche dans la file'
  }
}
